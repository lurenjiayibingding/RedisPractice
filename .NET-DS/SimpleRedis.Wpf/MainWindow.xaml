<Window x:Class="SimpleRedis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleRedis Desktop"
        MinWidth="860" MinHeight="580"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas">
    <DockPanel LastChildFill="True" Margin="10">

        <!-- ═══ 顶部：连接设置 ═══ -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#CCC" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="3,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Text="127.0.0.1" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Text="6379" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="User:" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <TextBox Grid.Row="0" Grid.Column="5" x:Name="UserBox" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Pass:" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <PasswordBox Grid.Row="0" Grid.Column="7" x:Name="PassBox" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="DB:" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <TextBox Grid.Row="0" Grid.Column="9" x:Name="DbBox" Text="0" VerticalContentAlignment="Center"/>

                <Button Grid.Row="2" Grid.Column="0" x:Name="ConnectBtn" Content="连接" Click="Connect_Click"
                        Width="80" Margin="0,0,6,0"/>
                <Button Grid.Row="2" Grid.Column="1" x:Name="DisconnectBtn" Content="断开" Click="Disconnect_Click"
                        Width="80" IsEnabled="False"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="StatusIcon" Text="○" FontSize="20"
                           Foreground="#999" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="StatusText" Text="未连接"
                           VerticalAlignment="Center" Foreground="#999" Margin="4,0,0,0" Grid.ColumnSpan="2"/>
                <Button Grid.Row="2" Grid.Column="12" x:Name="ClearBtn" Content="清屏"
                        Click="Clear_Click" Width="60" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══ 左侧：快捷命令 ═══ -->
        <Border DockPanel.Dock="Left"
                BorderBrush="#CCC" BorderThickness="1"
                CornerRadius="4" Padding="6"
                Width="140" Margin="0,0,8,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="— 快捷命令 —" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,0,0,6" Foreground="#555"/>
                    <Button Content="PING" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="PING"/>
                    <Button Content="DBSIZE" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="DBSIZE"/>
                    <Button Content="TIME" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="TIME"/>
                    <Button Content="INFO" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="INFO"/>
                    <Button Content="CLIENT LIST" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="CLIENT LIST"/>
                    <Separator Margin="0,6"/>
                    <TextBlock Text="— String —" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,0,0,4" Foreground="#555"/>
                    <Button Content="SET name Tom" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="SET name Tom"/>
                    <Button Content="GET name" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="GET name"/>
                    <Button Content="INCR counter" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="INCR counter"/>
                    <Button Content="APPEND" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="APPEND key hello"/>
                    <Button Content="STRLEN" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="STRLEN key"/>
                    <Separator Margin="0,6"/>
                    <TextBlock Text="— Key —" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,0,0,4" Foreground="#555"/>
                    <Button Content="EXISTS" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="EXISTS name"/>
                    <Button Content="TTL" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="TTL name"/>
                    <Button Content="TYPE" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="TYPE name"/>
                    <Button Content="KEYS *" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="KEYS *"/>
                    <Button Content="FLUSHDB" Style="{StaticResource CommandButton}" Click="QuickCmd_Click" Tag="FLUSHDB"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右侧：输出 + 输入 ═══ -->
        <DockPanel LastChildFill="True">
            <!-- 命令输入 -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="#CCC" BorderThickness="1"
                    CornerRadius="4" Padding="6" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text=">" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#2B579A"/>
                    <TextBox Grid.Column="1" x:Name="CmdBox"
                             FontSize="14" VerticalContentAlignment="Center"
                             KeyDown="CmdBox_KeyDown"/>
                    <Button Grid.Column="2" x:Name="SendBtn" Content="发送" Click="Send_Click"
                            Width="70" Margin="6,0,0,0" IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- 输出区域 -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="OutputBox"
                             IsReadOnly="True"
                             FontSize="13"
                             Padding="8"
                             TextWrapping="Wrap"
                             Background="#1E1E1E"
                             Foreground="#D4D4D4"
                             BorderThickness="0"/>
                </ScrollViewer>
            </Border>
        </DockPanel>

    </DockPanel>
</Window>
